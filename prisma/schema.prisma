// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mysql"
    url      = env("DATABASE_URL")
}

model User {
    id        Int       @id @default(autoincrement())
    fullName  String
    email     String    @unique
    password  String
    avatar    String?
    roleId    Int
    role      Role      @relation(fields: [roleId], references: [id])
    isActive  Boolean   @default(true)
    createdBy Int?
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    isDeleted Boolean   @default(false)
    deletedAt DateTime?

    modulePermissions      UserModulePermission[]
    providedTasks          Task[]                 @relation("UserProvidedTasks")
    solvedTasks            Task[]                 @relation("UserSolvedTasks")
    meeting                Meeting[]
    handledChats           Chat[]                 @relation("ChatHandledBy")
    createdChats           Chat[]                 @relation("ChatCreatedBy")
    updatedChats           Chat[]                 @relation("ChatUpdatedBy")
    approachedReviews      Review[]               @relation("ReviewApproachedBy")
    createdReviews         Review[]               @relation("ReviewCreatedBy")
    updatedReviews         Review[]               @relation("ReviewUpdatedBy")
    createdFeatureRequests FeatureRequest[]       @relation("FeatureCreatedBy")
    updatedFeatureRequests FeatureRequest[]       @relation("FeatureUpdatedBy")
    activityLogs           ActivityLog[]
    comments               Comment[]
    commentMentions        CommentMention[]
    sendByUserApp          CollaborationApp[]     @relation("SendByUser")
    AddedByUserApp         CollaborationApp[]     @relation("AddedByUser")

    @@index([email])
    @@map("users")
}

model Role {
    id        Int       @id @default(autoincrement())
    name      String
    slug      String    @unique
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    isDeleted Boolean   @default(false)
    deletedAt DateTime?

    users User[]

    @@map("roles")
}

model Permission {
    id        Int       @id @default(autoincrement())
    name      String
    slug      String    @unique
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    isDeleted Boolean   @default(false)
    deletedAt DateTime?

    modulePermissions UserModulePermission[]

    @@map("permissions")
}

model Module {
    id        Int       @id @default(autoincrement())
    name      String
    slug      String    @unique
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    isDeleted Boolean   @default(false)
    deletedAt DateTime?

    modulePermissions UserModulePermission[]

    @@map("modules")
}

model UserModulePermission {
    id           Int @id @default(autoincrement())
    userId       Int
    moduleId     Int
    permissionId Int

    user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
    module     Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
    permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    isDeleted Boolean   @default(false)
    deletedAt DateTime?

    @@map("user_module_permissions")
}

model Client {
    id         Int       @id @default(autoincrement())
    shopDomain String    @unique
    email      String?
    shopName   String?
    platformId Int?
    createdAt  DateTime  @default(now())
    updatedAt  DateTime? @updatedAt
    isDeleted  Boolean   @default(false)
    deletedAt  DateTime?

    // Relations
    platform         Platform?         @relation(fields: [platformId], references: [id])
    chat             Chat[]
    clientEmail      ClientEmail[]
    task             Task[]
    marketingFunnels MarketingFunnel[]
    featureRequests  FeatureRequest[]

    @@index([shopDomain, email])
    @@map("clients")
}

model Platform {
    id        Int       @id @default(autoincrement())
    projectId Int
    name      String
    slug      String    @unique
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    isDeleted Boolean   @default(false)
    deletedAt DateTime?

    // Relations
    project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
    clients Client[]

    @@map("platforms")
}

model Project {
    id        Int       @id @default(autoincrement())
    name      String
    slug      String    @unique
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    isDeleted Boolean   @default(false)
    deletedAt DateTime?

    // Relations
    platforms        Platform[]
    chats            Chat[]
    tasks            Task[]
    meetings         Meeting[]
    CollaborationApp CollaborationApp[]

    @@map("projects")
}

// =======================
// Chat Table
// =======================
model Chat {
    id                 Int       @id @default(autoincrement())
    clientId           Int?
    clientQuery        String    @db.Text
    handleBy           Int?
    projectId          Int?
    chatDate           DateTime?
    chatTranscript     String?   @db.Text
    storefrontPassword String?   @db.Text
    externalChat       Boolean?  @default(false)
    shopUrl            String?   @db.Text
    shopName           String?   @db.Text
    shopEmail          String?   @db.Text
    clientFeedback     String?   @db.Text
    storeDetails       String?   @db.Text
    agentComments      String?   @db.Text
    otherStoresUrl     String?   @db.Text
    changesMadeByAgent String?   @db.Text
    isDeleted          Boolean   @default(false)
    deletedAt          DateTime?
    createdBy          Int?
    updatedBy          Int?
    createdAt          DateTime  @default(now())
    updatedAt          DateTime  @updatedAt

    // Relations
    handleByUser   User?           @relation("ChatHandledBy", fields: [handleBy], references: [id])
    createdByUser  User?           @relation("ChatCreatedBy", fields: [createdBy], references: [id])
    updatedByUser  User?           @relation("ChatUpdatedBy", fields: [updatedBy], references: [id])
    client         Client?         @relation(fields: [clientId], references: [id])
    project        Project?        @relation(fields: [projectId], references: [id])
    chatTags       ChatTag[]
    review         Review?
    featureRequest FeatureRequest?
    comments       Comment[]

    @@map("chats")
}

// =======================
// Review Table
// =======================
model Review {
    id                 Int       @id @default(autoincrement())
    chatId             Int?      @unique
    meetingId          Int?      @unique
    reviewAsked        Boolean?  @default(false)
    reviewStatus       Boolean?  @default(false)
    shopUrl            String?
    shopName           String?
    reviewText         String?   @db.Text
    reviewNotAskReason String?   @db.Text
    agentRating        Int?
    ratingMood         String? // "positive" | "neutral" | "negative"
    lastReviewApproach DateTime?
    reviewDate         DateTime?
    reviewApproachBy   Int?
    reviewSubmittedAt  DateTime?
    createdBy          Int?
    updatedBy          Int?
    createdAt          DateTime  @default(now())
    updatedAt          DateTime  @updatedAt

    // Relations
    chat           Chat?    @relation(fields: [chatId], references: [id])
    meeting        Meeting? @relation(fields: [meetingId], references: [id])
    approachByUser User?    @relation("ReviewApproachedBy", fields: [reviewApproachBy], references: [id])
    createdByUser  User?    @relation("ReviewCreatedBy", fields: [createdBy], references: [id])
    updatedByUser  User?    @relation("ReviewUpdatedBy", fields: [updatedBy], references: [id])

    @@map("reviews")
}

// =======================
// Feature Request Table
// =======================
model FeatureRequest {
    id             Int      @id @default(autoincrement())
    clientId       Int?
    chatId         Int?     @unique
    featureDetails String?  @db.Text
    shopUrl        String?
    shopName       String?
    email          String?
    createdBy      Int?
    updatedBy      Int?
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt

    // Relations
    client        Client? @relation(fields: [clientId], references: [id])
    chat          Chat?   @relation(fields: [chatId], references: [id])
    createdByUser User?   @relation("FeatureCreatedBy", fields: [createdBy], references: [id])
    updatedByUser User?   @relation("FeatureUpdatedBy", fields: [updatedBy], references: [id])

    @@map("feature_requests")
}

model Tag {
    id        Int      @id @default(autoincrement())
    name      String   @unique
    createdAt DateTime @default(now())

    chatTags ChatTag[]
}

model ChatTag {
    chatId Int
    tagId  Int

    chat Chat @relation(fields: [chatId], references: [id])
    tag  Tag  @relation(fields: [tagId], references: [id])

    @@id([chatId, tagId])
    @@map("chat_tags")
}

model ClientEmail {
    id        Int       @id @default(autoincrement())
    clientId  Int
    email     String    @unique
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    isDeleted Boolean   @default(false)
    deletedAt DateTime?

    client Client @relation(fields: [clientId], references: [id])

    @@map("client_emails")
}

model Task {
    id            Int       @id @default(autoincrement())
    clientId      Int
    providedBy    Int
    solvedBy      Int?
    projectId     Int?
    taskDetails   String    @db.Text
    statusId      Int?
    storePassword String?
    storeAccess   String?
    taskAddedDate DateTime?
    notes         String?   @db.Text
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt
    isDeleted     Boolean   @default(false)
    deletedAt     DateTime?

    // Relations
    client         Client    @relation(fields: [clientId], references: [id])
    providedByUser User      @relation("UserProvidedTasks", fields: [providedBy], references: [id])
    solvedByUser   User?     @relation("UserSolvedTasks", fields: [solvedBy], references: [id])
    status         Status?   @relation(fields: [statusId], references: [id])
    project        Project?  @relation(fields: [projectId], references: [id])
    comments       Comment[]

    @@map("tasks")
}

model Status {
    id        Int       @id @default(autoincrement())
    name      String
    slug      String    @unique
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    isDeleted Boolean   @default(false)
    deletedAt DateTime?
    tasks     Task[]

    @@map("statuses")
}

model Meeting {
    id                Int       @id @default(autoincrement())
    agentId           Int
    projectId         Int?
    storeUrl          String    @db.Text
    isExternalMeeting Boolean?  @default(false)
    meetingDetails    String?   @db.Text
    meetingDateTime   DateTime
    joiningStatus     Boolean?  @default(false)
    recordedVideo     String?   @db.Text
    meetingNotes      String?   @db.Text
    createdAt         DateTime  @default(now())
    updatedAt         DateTime  @updatedAt
    isDeleted         Boolean   @default(false)
    deletedAt         DateTime?

    // Each meeting can have multiple associated emails
    emails MeetingEmail[]

    // Relations
    user    User     @relation(fields: [agentId], references: [id])
    project Project? @relation(fields: [projectId], references: [id])
    review  Review?

    @@map("meetings")
}

model MeetingEmail {
    id        Int       @id @default(autoincrement())
    email     String
    meetingId Int
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    isDeleted Boolean   @default(false)
    deletedAt DateTime?

    meeting Meeting @relation(fields: [meetingId], references: [id])

    @@unique([meetingId, email])
    @@map("meeting_emails")
}

model MarketingFunnel {
    id                  Int       @id @default(autoincrement())
    clientId            Int
    followUpStep        String?
    followUpDate        DateTime?
    installPhase        String?
    typeOfProducts      String?
    otherAppsInstalled  String?
    customizationType   String?
    initialFeedback     String?   @db.Text
    clientSuccessStatus String?
    currentPhase        Boolean   @default(false)
    createdAt           DateTime  @default(now())
    updatedAt           DateTime  @updatedAt
    isDeleted           Boolean   @default(false)
    deletedAt           DateTime?

    client Client @relation(fields: [clientId], references: [id])

    @@map("marketing_funnels")
}

model ActivityLog {
    id        Int      @id @default(autoincrement())
    userId    Int?
    desc      String?
    action    String? // "CREATE", "UPDATE", "DELETE", "COMMENT", "REVIEW", etc.
    modelName String? // e.g., "Chat", "Task", "Comment", "Review"
    recordId  Int? // ID of the affected record
    changes   Json? // JSON object storing what changed
    metadata  Json? // optional, e.g., parent record, extra info
    createdAt DateTime @default(now())

    user User? @relation(fields: [userId], references: [id])

    @@index([userId])
    @@index([modelName, recordId])
    @@map("activity_logs")
}

model Comment {
    id        Int       @id @default(autoincrement())
    content   String    @db.Text
    userId    Int
    chatId    Int?
    taskId    Int?
    parentId  Int?
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    isDeleted Boolean   @default(false)
    deletedAt DateTime?

    // Relations
    user User  @relation(fields: [userId], references: [id])
    chat Chat? @relation(fields: [chatId], references: [id])
    task Task? @relation(fields: [taskId], references: [id])

    parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
    replies Comment[] @relation("CommentReplies")

    // Mentions (many-to-many)
    mentions CommentMention[]

    @@index([chatId])
    @@index([taskId])
    @@map("comments")
}

model CommentMention {
    id          Int @id @default(autoincrement())
    commentId   Int
    mentionedId Int

    // Relations
    comment   Comment @relation(fields: [commentId], references: [id])
    mentioned User    @relation(fields: [mentionedId], references: [id])

    @@unique([commentId, mentionedId])
    @@map("comment_mentions")
}

model CollaborationApp {
    id             Int       @id @default(autoincrement())
    projectId      Int?
    appName        String
    appUrl         String?
    companyName    String?
    companyUrl     String?
    appDetails     String?   @db.Text
    appAddedDate   DateTime?
    statusId       Int?
    completedDate  DateTime?
    comments       String?   @db.Text
    meetingDetails String?   @db.Text
    sendById       Int?
    addedById      Int?
    requestType    String?
    createdAt      DateTime  @default(now())
    updatedAt      DateTime  @updatedAt

    emails             CollaborationAppEmail[]
    collaborationAreas CollaborationAppArea[]
    status             CollaborationStatus?  @relation(fields: [statusId], references: [id])
    sendBy             User?                   @relation("SendByUser", fields: [sendById], references: [id])
    addedBy            User?                   @relation("AddedByUser", fields: [addedById], references: [id])
    project            Project?                @relation(fields: [projectId], references: [id])
}

model CollaborationAppEmail {
    id    Int              @id @default(autoincrement())
    email String
    appId Int
    app   CollaborationApp @relation(fields: [appId], references: [id])
}

model CollaborationAppArea {
    id           Int                     @id @default(autoincrement())
    appId        Int
    areaOptionId Int
    app          CollaborationApp        @relation(fields: [appId], references: [id])
    areaOption   CollaborationArea @relation(fields: [areaOptionId], references: [id])

    @@unique([appId, areaOptionId])
}

model CollaborationArea {
    id   Int                    @id @default(autoincrement())
    name String                 @unique
    slug String                 @unique
    createdAt      DateTime  @default(now())
    updatedAt      DateTime  @updatedAt
    apps CollaborationAppArea[]
}

model CollaborationStatus {
    id   Int                @id @default(autoincrement())
    name String             @unique
    slug String             @unique
    createdAt      DateTime  @default(now())
    updatedAt      DateTime  @updatedAt
    apps CollaborationApp[]
}
